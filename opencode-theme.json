        "darkBlueBright": "#6699ff",
        "darkGreen": "#6aab73",
        "darkGreenBright": "#8ed16a",
        "darkRed": "#f85149",
        "darkRedBright": "#ff8a85",
        "darkYellow": "#ff8a00",
        "darkYellowBright": "#ffb347",
        "darkOrange": "#ffa763",
        "darkPink": "#ba8ef7",
        "darkPurple": "#cf8e6d",
        "darkTeal": "#14b8a6",
        "darkSyntaxYellow": "#ffb347",
        "darkSyntaxOrange": "#ffa763",
        "darkSyntaxGreen": "#6aab73",
