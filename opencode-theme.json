        "markdownCodeBlock": {
            "dark": "darkTeal",
            "light": "lightFg"
        },
        "syntaxComment": {
            "dark": "darkMuted",
            "light": "lightMuted"
        },
        "syntaxKeyword": {
            "dark": "darkPink",
            "light": "lightPurple"
        },
        "syntaxFunction": {
            "dark": "darkPurple",
            "light": "lightOrange"
        },
        "syntaxVariable": {
            "dark": "darkTeal",
            "light": "lightFg"
        },
        "syntaxString": {
            "dark": "darkGreen",
            "light": "lightPurple"
        },
        "syntaxNumber": {
            "dark": "darkSyntaxBlue",
            "light": "lightPink"
