    "theme": {
        "primary": {
            "dark": "darkBlue",
            "light": "lightBlue"
        },
        "secondary": {
            "dark": "darkTeal",
            "light": "lightTeal"
        },
        "accent": {
            "dark": "darkBlue",
            "light": "lightBlue"
        },
        "error": {
            "dark": "darkRed",
            "light": "lightRed"
        },
        "warning": {
            "dark": "darkYellow",
            "light": "lightOrange"
        },
        "success": {
            "dark": "darkGreen",
            "light": "lightGreen"
        },
        "info": {
            "dark": "darkBlue",
            "light": "lightBlue"
        },
        "text": {
            "dark": "darkFg",
            "light": "lightFg"
        },
        "textMuted": {
            "dark": "darkMuted",
            "light": "lightMuted"
        },
        "background": {
            "dark": "darkBg",
            "light": "lightBg"
