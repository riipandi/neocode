        "syntaxType": {
            "dark": "darkOrange",
            "light": "lightBlueDark"
        },
        "syntaxOperator": {
            "dark": "darkTeal",
            "light": "lightFg"
        },
        "syntaxPunctuation": {
            "dark": "darkTeal",
            "light": "lightFg"
        }
