        "lightGreen": "#6aab73",
        "lightGreenBright": "#8ed16a",
        "lightRed": "#f85149",
        "lightRedBright": "#ff8a85",
        "lightOrange": "#ff8a00",
        "lightYellow": "#ffb347",
        "lightPurple": "#ba8ef7",
        "lightPurpleDark": "#cf8e6d",
        "lightPink": "#d4aaff"
