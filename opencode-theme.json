        "markdownLinkText": {
            "dark": "darkBlue",
            "light": "lightMuted"
        },
        "markdownCode": {
            "dark": "darkGreen",
            "light": "lightGreen"
        },
        "markdownBlockQuote": {
            "dark": "darkMuted",
            "light": "lightMuted"
        },
        "markdownEmph": {
            "dark": "darkTeal",
            "light": "lightFg"
        },
        "markdownStrong": {
            "dark": "darkPink",
            "light": "lightFg"
        },
        "markdownHorizontalRule": {
