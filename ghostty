# Config generated by Ghostty Config (https://ghostty.zerebos.com)
# Colors from color-name.com (https://www.color-name.com/colors)
# Reference: https://ghostty.org/docs/config/reference
# mkdir -p ~/.config/ghostty ; touch $_/config2

# Only check for updates, don't auto-update.
auto-update = check
auto-update-channel = stable

# Initial command to run, change the initial directory
command = zsh -c "cd $HOME/Developer && exec zsh"
working-directory = inherit

# Common configurations.
adjust-cell-height = "12%"
adjust-cell-width = "3%"
background-blur = true
background-opacity = 0.99
background-blur-radius = 40
bold-is-bright = false
clipboard-paste-bracketed-safe = true
clipboard-paste-protection = false
clipboard-read = allow
clipboard-write = allow
confirm-close-surface = false
copy-on-select = false
cursor-style = block
cursor-style-blink = false
grapheme-width-method = unicode
freetype-load-flags = hinting,force-autohint,monochrome,autohint
font-feature = +calt, +liga, +dlig
font-family = "Maple Mono NF"
font-size = 14
font-style = normal
font-thicken = false
fullscreen = false
macos-auto-secure-input = true

# official|blueprint|chalkboard|microchip|glass|holographic|paper|retro|xray|custom-style
macos-icon = xray

# aluminum|beige|plastic|chrome
macos-icon-frame = plastic

macos-non-native-fullscreen = visible-menu
macos-secure-input-indication = true
macos-titlebar-proxy-icon = hidden

# hidden|transparent|native|tabs
macos-titlebar-style = transparent

macos-window-buttons = hidden
macos-window-shadow = true
maximize = true
mouse-hide-while-typing = false
mouse-scroll-multiplier = 2
quit-after-last-window-closed = true
scrollback-limit = 524288000
shell-integration = zsh
shell-integration-features = no-cursor,sudo,no-title,ssh-terminfo,ssh-env
term = xterm-256color
title = "Neocode"
unfocused-split-opacity = 0.6
split-divider-color = #032333
window-colorspace = display-p3
window-decoration = auto
window-height = 3200
window-inherit-working-directory = true
window-inherit-font-size = true
window-new-tab-position = end
window-padding-balance = true
window-padding-x = 6
window-padding-y = 2
window-padding-balance = true
window-titlebar-background = #181a1d
window-titlebar-foreground = #a5a8b0
window-position-x = 380
window-position-y = 158
window-save-state = default
window-theme = auto
window-title-font-family = Seravek
window-subtitle = working-directory
window-width = 13200

# Open Quick Terminal with cmd+grave_accent (tilde) while Ghostty open.
# Reference: https://dbushell.com/2025/04/11/ghostty-macos-quick-terminal
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-animation-duration = 2.0
quick-terminal-autohide = true
quick-terminal-position = bottom
quick-terminal-position = center
quick-terminal-screen = main
quick-terminal-screen = mouse
quick-terminal-size = 25%,100%
quick-terminal-space-behavior = move

# ghostty +list-themes
# Flexoki Dark | Mathias | Catppuccin Frappe
# theme = Flexoki Dark

# === Atomizer Dark Island Theme (from VS Code) ===
background = #181a1d
foreground = #d4d5d9
cursor-color = #ffffff
cursor-text = #181a1d
selection-background = #336ff1
selection-foreground = #ffffff

palette = 0=#191a1c
palette = 1=#ff6b66
palette = 2=#8ed16a
palette = 3=#ffb347
palette = 4=#6699ff
palette = 5=#d4aaff
palette = 6=#4dd0e1
palette = 7=#e0e2e8
palette = 8=#7a7e85
palette = 9=#ff8a85
palette = 10=#a3e635
palette = 11=#ffd966
palette = 12=#9bc4ff
palette = 13=#e8b4ff
palette = 14=#70d4e8
palette = 15=#ffffff

